<Window x:Class="DirectoryMonitor.Presentation.Views.OutputEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewModels="clr-namespace:DirectoryMonitor.Presentation.ViewModels"
        Title="{DynamicResource OutputEditorTitle}" Width="760" Height="760" MinWidth="650" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" Icon="../Assets/directory-monitor.ico">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer><StackPanel>
            <GroupBox Header="{DynamicResource Destination}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource NameLabel}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource TypeLabel}" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DestinationTypes}" SelectedItem="{Binding Type}"/>
                <CheckBox Grid.Row="2" Grid.Column="1" Content="{DynamicResource Disabled}" IsChecked="{Binding IsDisabled}" Margin="4,7"/>
            </Grid></GroupBox>
            <GroupBox Header="{DynamicResource TextFile}" Visibility="{Binding IsText,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="150"/><RowDefinition/><RowDefinition/><RowDefinition Height="100"/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource FilePath}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding FilePath,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="..." MinWidth="32" Click="BrowseFile_Click"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource Format}" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TextFormats}" SelectedItem="{Binding Format}"/>
                <TextBlock Grid.Row="2" Text="{DynamicResource Template}" VerticalAlignment="Top" Margin="0,8"/><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Template,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                <TextBlock Grid.Row="3" Text="{DynamicResource RotateAt}" VerticalAlignment="Center"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"><TextBox Text="{Binding RotateSizeMb,UpdateSourceTrigger=PropertyChanged}" Width="90"/><TextBlock Text="MB" VerticalAlignment="Center" Margin="5,0"/></StackPanel>
                <TextBlock Grid.Row="4" Text="{DynamicResource Retention}" VerticalAlignment="Center"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><TextBox Text="{Binding RetentionDays,UpdateSourceTrigger=PropertyChanged}" Width="90"/><TextBlock Text="{DynamicResource Days}" VerticalAlignment="Center" Margin="5,0"/></StackPanel>
                <TextBlock Grid.Row="5" Text="{DynamicResource Preview}" VerticalAlignment="Top" Margin="0,8"/><TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Preview,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{DynamicResource PanelBrush}"/>
            </Grid></GroupBox>
            <GroupBox Header="{DynamicResource Database}" Visibility="{Binding IsDatabase,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource ConnectionString}" VerticalAlignment="Top" Margin="0,8"/><TextBox Grid.Column="1" Text="{Binding ConnectionString,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource SqlServerAuthenticationLabel}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSqlServer}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding SelectedSqlServerSampleAuthentication}" SelectedValuePath="Tag"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSqlServer}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBoxItem Content="{DynamicResource WindowsAuthentication}" Tag="{x:Static viewModels:SqlServerSampleAuthentication.WindowsAuthentication}"/><ComboBoxItem Content="{DynamicResource SqlLogin}" Tag="{x:Static viewModels:SqlServerSampleAuthentication.SqlLogin}"/></ComboBox>
                <TextBlock Grid.Row="2" Text="{DynamicResource ConnectionStringExample}" VerticalAlignment="Top" Margin="0,8"/><Grid Grid.Row="2" Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox Text="{Binding DatabaseConnectionExample,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="78" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{DynamicResource PanelBrush}"/><Button Grid.Row="1" Content="{DynamicResource UseSample}" HorizontalAlignment="Right" Click="UseSample_Click"/></Grid>
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="4,8" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource PostgreSqlConnectionHelp}"/><Style.Triggers><DataTrigger Binding="{Binding IsSqlServer}" Value="True"><Setter Property="Text" Value="{DynamicResource SqlServerWindowsConnectionHelp}"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSqlServer}" Value="True"/><Condition Binding="{Binding SelectedSqlServerSampleAuthentication}" Value="{x:Static viewModels:SqlServerSampleAuthentication.SqlLogin}"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="{DynamicResource SqlServerLoginConnectionHelp}"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource PropertiesAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="4"><TextBlock Text="{DynamicResource DatabaseConnectionCommonHelp}" TextWrapping="Wrap" Foreground="{DynamicResource PropertiesForegroundBrush}"/></Border>
            </Grid></GroupBox>
            <Border Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource ChangeAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="6"><TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Foreground="{DynamicResource ChangeForegroundBrush}"/></Border>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{DynamicResource TestWrite}" HorizontalAlignment="Left" Click="Test_Click"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource Save}" IsDefault="True" Click="Save_Click"/><Button Content="{DynamicResource Cancel}" IsCancel="True"/></StackPanel></Grid>
    </Grid>
</Window>
