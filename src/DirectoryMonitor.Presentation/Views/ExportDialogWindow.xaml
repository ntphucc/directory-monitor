<Window x:Class="DirectoryMonitor.Presentation.Views.ExportDialogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource ExportTitle}" Width="610" Height="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource ExportDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
        <GroupBox Grid.Row="1" Header="{DynamicResource Categories}" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><CheckBox x:Name="DirectoriesBox" Content="{DynamicResource Directories}" IsChecked="True" Margin="8"/><CheckBox x:Name="EventsBox" Content="{DynamicResource Events}" IsChecked="True" Margin="8"/><CheckBox x:Name="OutputsBox" Content="{DynamicResource Outputs}" IsChecked="True" Margin="8"/></StackPanel></GroupBox>
        <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource DestinationFile}" VerticalAlignment="Center"/><TextBox x:Name="FilePathBox" Grid.Column="1"/><Button Grid.Column="2" Content="{DynamicResource Browse}" Click="Browse_Click"/></Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Format}" VerticalAlignment="Center"/><ComboBox x:Name="FormatBox" Grid.Column="1" SelectionChanged="FormatBox_SelectionChanged"><ComboBoxItem Content="JSON" Tag="Json" IsSelected="True"/><ComboBoxItem Content="XML" Tag="Xml"/><ComboBoxItem Content="Directory Monitor (.dm)" Tag="Dm"/></ComboBox></Grid>
        <GroupBox x:Name="PasswordPanel" Grid.Row="4" Header="{DynamicResource EncryptionPassword}" Margin="0,12,0,0" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Password}" VerticalAlignment="Center"/><PasswordBox x:Name="PasswordBox" Grid.Column="1" Margin="3"/><TextBlock Grid.Row="1" Text="{DynamicResource ConfirmPassword}" VerticalAlignment="Center"/><PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="1" Grid.Column="1" Margin="3"/><TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource DmEncryptionHelp}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="3,8"/></Grid></GroupBox>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{DynamicResource Export}" Click="Export_Click" IsDefault="True"/><Button Content="{DynamicResource Cancel}" IsCancel="True"/></StackPanel>
    </Grid>
</Window>
