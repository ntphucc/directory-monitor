<Window x:Class="DirectoryMonitor.Presentation.Views.DirectoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DirectoryMonitor.Presentation.Converters" Title="{DynamicResource DirectoryEditorTitle}"
        Width="720" Height="760" MinWidth="650" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" Icon="../Assets/directory-monitor.ico">
    <Window.Resources><conv:EnumBooleanConverter x:Key="EnumBoolean"/></Window.Resources>
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl Grid.Row="0">
            <TabItem Header="{DynamicResource Main}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="5">
                <GroupBox Header="{DynamicResource Directory}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="80"/></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource DirectoryLabel}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Path,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="..." MinWidth="32" Click="Browse_Click"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource DescriptionLabel}" VerticalAlignment="Top" Margin="0,8,0,0"/><TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid></GroupBox>
                <GroupBox Header="{DynamicResource Options}"><StackPanel>
                    <WrapPanel Margin="0,2"><TextBlock Text="{DynamicResource EventsLabel}" Width="105" VerticalAlignment="Center"/><CheckBox Content="New" IsChecked="{Binding MonitorNew}" Margin="4"/><CheckBox Content="Change" IsChecked="{Binding MonitorChange}" Margin="12,4"/><CheckBox Content="Modify Properties" IsChecked="{Binding MonitorProperties}" Margin="12,4"/><CheckBox Content="Delete" IsChecked="{Binding MonitorDelete}" Margin="12,4"/></WrapPanel>
                    <CheckBox Content="{DynamicResource MonitorSubdirectories}" IsChecked="{Binding MonitorSubdirectories}" Margin="109,5,0,0"/>
                    <CheckBox Content="{DynamicResource DailyReconciliation}" IsChecked="{Binding DailyReconciliation}" Margin="109,5,0,0"/>
                    <WrapPanel Margin="0,8"><TextBlock Text="{DynamicResource EntryTypes}" Width="105" VerticalAlignment="Center"/><RadioButton GroupName="EntryType" Content="{DynamicResource FilesDirectories}" IsChecked="{Binding EntryTypeFilter,Converter={StaticResource EnumBoolean},ConverterParameter=FilesAndDirectories}"/><RadioButton GroupName="EntryType" Content="{DynamicResource FilesOnly}" Margin="14,0" IsChecked="{Binding EntryTypeFilter,Converter={StaticResource EnumBoolean},ConverterParameter=FilesOnly}"/><RadioButton GroupName="EntryType" Content="{DynamicResource DirectoriesOnly}" IsChecked="{Binding EntryTypeFilter,Converter={StaticResource EnumBoolean},ConverterParameter=DirectoriesOnly}"/></WrapPanel>
                </StackPanel></GroupBox>
                <GroupBox Header="{DynamicResource Filters}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource ExcludePatterns}"/><TextBlock Grid.Column="2" Text="{DynamicResource IncludePatterns}"/><TextBox Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding ExcludePatterns,UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Row="1" Grid.Column="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding IncludePatterns,UpdateSourceTrigger=PropertyChanged}"/>
                </Grid></GroupBox>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="{DynamicResource TabOutputs}"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{DynamicResource SelectOutputs}" Foreground="{DynamicResource MutedBrush}"/><ListBox Grid.Row="1" ItemsSource="{Binding Outputs}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Padding="5"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="260"/><TextBlock Text="{Binding Type}" Foreground="{DynamicResource MutedBrush}" Width="150"/><TextBlock Text="{Binding Destination.Status}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
        </TabControl>
        <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DeleteAccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource Save}" IsDefault="True" Click="Save_Click"/><Button Content="{DynamicResource Cancel}" IsCancel="True"/></StackPanel></Grid>
    </Grid>
</Window>
