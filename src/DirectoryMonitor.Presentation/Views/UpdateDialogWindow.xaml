<Window x:Class="DirectoryMonitor.Presentation.Views.UpdateDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UpdateDialogTitle}" Width="560" Height="440" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource UpdateAvailableTitle}" FontSize="22" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" Margin="0,16,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource CurrentVersionLabel}" Margin="0,3,14,3"/><TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" FontWeight="SemiBold" Margin="0,3"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource NewVersionLabel}" Margin="0,3,14,3"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NewVersion}" FontWeight="SemiBold" Margin="0,3"/>
            <TextBlock Grid.Row="2" Text="{DynamicResource PublishedLabel}" Margin="0,3,14,3"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PublishedAt}" Margin="0,3"/>
        </Grid>
        <GroupBox Grid.Row="2" Header="{DynamicResource ChangesLabel}" Margin="0"><ListBox ItemsSource="{Binding ReleaseNotes}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="3"/></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource UpdateNow}" IsDefault="True" Click="Update_Click"/>
            <Button Content="{DynamicResource SkipThisVersion}" Click="Skip_Click"/>
            <Button Content="{DynamicResource Later}" IsCancel="True" Click="Later_Click"/>
        </StackPanel>
    </Grid>
</Window>
