<Window x:Class="DirectoryMonitor.Presentation.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DownloadingUpdate}" Width="480" Height="190" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource DownloadingAndVerifying}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ProgressBar x:Name="DownloadProgress" Grid.Row="1" Height="20" Minimum="0" Maximum="100" Margin="0,16"/>
        <Button Grid.Row="2" Content="{DynamicResource Cancel}" HorizontalAlignment="Right" Click="Cancel_Click"/>
    </Grid>
</Window>
