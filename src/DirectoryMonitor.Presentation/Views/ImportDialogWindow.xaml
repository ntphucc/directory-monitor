<Window x:Class="DirectoryMonitor.Presentation.Views.ImportDialogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource ImportTitle}" Width="650" Height="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource ImportDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
        <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource SourceFile}" VerticalAlignment="Center"/><TextBox x:Name="FilePathBox" Grid.Column="1"/><Button Grid.Column="2" Content="{DynamicResource Browse}" Click="Browse_Click"/></Grid>
        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource PasswordOptional}" VerticalAlignment="Center"/><PasswordBox x:Name="PasswordBox" Grid.Column="1" Margin="3"/><Button Grid.Column="2" Content="{DynamicResource Preview}" Click="Preview_Click"/></Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="3,10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        <GroupBox Grid.Row="4" Header="{DynamicResource ImportPreview}"><StackPanel><CheckBox x:Name="DirectoriesBox" Margin="8" IsEnabled="False"/><CheckBox x:Name="EventsBox" Margin="8" IsEnabled="False"/><CheckBox x:Name="OutputsBox" Margin="8" IsEnabled="False"/><TextBlock Text="{DynamicResource ImportedConfigsDisabledHelp}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="8,12"/></StackPanel></GroupBox>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="ImportButton" Content="{DynamicResource Import}" Click="Import_Click" IsEnabled="False" IsDefault="True"/><Button Content="{DynamicResource Cancel}" IsCancel="True"/></StackPanel>
    </Grid>
</Window>
