<Window x:Class="DirectoryMonitor.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:DirectoryMonitor.Domain;assembly=DirectoryMonitor.Domain"
        mc:Ignorable="d"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="660"
        Icon="Assets/directory-monitor.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Application header -->
        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBrush}" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="42"
                        Height="42"
                        CornerRadius="11"
                        Background="{DynamicResource PrimaryBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,13,0">
                    <Path Data="{StaticResource IconMonitor}"
                          Stroke="{DynamicResource PrimaryForegroundBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="24"
                          Height="24"
                          Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Directory Monitor"
                               Foreground="{DynamicResource AppHeaderForegroundBrush}"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Subtitle}"
                               Foreground="{DynamicResource AppHeaderMutedBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding ShowUpdateCommand}"
                        Margin="10,0"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconImport}" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{DynamicResource UpdateAvailableBadge}" />
                            <Run Text="{Binding AvailableUpdateVersion, StringFormat={} v{0}}" />
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Border Grid.Column="3"
                        Background="#18FFFFFF"
                        CornerRadius="18"
                        Padding="12,7"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource AppHeaderForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="4"
                        Click="ExitApplication_Click"
                        Style="{StaticResource HeaderButtonStyle}"
                        Margin="10,0,0,0"
                        ToolTip="{DynamicResource ExitConfirmation}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconExit}" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="{DynamicResource ExitApplication}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <TabControl Grid.Row="1" Margin="20,16,20,14">
            <TabItem Header="{DynamicResource TabMonitoring}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="205" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolder}"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  Width="20"
                                  Height="20"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Directory}" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding AddDirectoryCommand}" Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconAdd}" Style="{StaticResource ToolbarIconStyle}" />
                                    <TextBlock Text="{DynamicResource AddDirectory}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding EditDirectoryCommand}" Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconEdit}" Style="{StaticResource ToolbarIconStyle}" />
                                    <TextBlock Text="{DynamicResource Edit}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleDirectoryCommand}" Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPower}" Style="{StaticResource ToolbarIconStyle}" />
                                    <TextBlock Text="{DynamicResource EnableDisable}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteDirectoryCommand}" Style="{StaticResource DangerButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDelete}" Style="{StaticResource ToolbarIconStyle}" />
                                    <TextBlock Text="{DynamicResource Delete}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="DirectoryGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Directories}"
                              SelectedItem="{Binding SelectedDirectory}"
                              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="DirectoryGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource Edit}" Command="{Binding EditDirectoryCommand}" />
                                <MenuItem Header="{DynamicResource Duplicate}" Command="{Binding DuplicateDirectoryCommand}" />
                                <MenuItem Header="{DynamicResource Delete}" Command="{Binding DeleteDirectoryCommand}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Open}" Command="{Binding OpenSelectedDirectoryCommand}" />
                                <MenuItem Header="{DynamicResource CopyPath}" Command="{Binding CopySelectedDirectoryPathCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Status}" Width="72" CellStyle="{StaticResource CenteredDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Path Width="19"
                                              Height="19"
                                              Stretch="Uniform"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center">
                                            <Path.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{DynamicResource DirectoryStatusUnavailable}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Monitoring}"><Setter Property="Text" Value="{DynamicResource DirectoryStatusMonitoring}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Disabled}"><Setter Property="Text" Value="{DynamicResource DirectoryStatusDisabled}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Unavailable}"><Setter Property="Text" Value="{DynamicResource DirectoryStatusUnavailable}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Reconnecting}"><Setter Property="Text" Value="{DynamicResource DirectoryStatusReconnecting}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Error}"><Setter Property="Text" Value="{DynamicResource DirectoryStatusError}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxWidth="360" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Path.ToolTip>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource IconWarning}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource PropertiesAccentBrush}" />
                                                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource DirectoryStatusUnavailable}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Monitoring}">
                                                            <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource NewAccentBrush}" />
                                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource DirectoryStatusMonitoring}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Disabled}">
                                                            <Setter Property="Data" Value="{StaticResource IconDisabled}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource DeleteAccentBrush}" />
                                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource DirectoryStatusDisabled}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Reconnecting}">
                                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource DirectoryStatusReconnecting}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:DirectoryMonitorStatus.Error}">
                                                            <Setter Property="Data" Value="{StaticResource IconError}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource DeleteAccentBrush}" />
                                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource DirectoryStatusError}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Directory}" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Description}" Binding="{Binding Description}" Width="250" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Events}" Binding="{Binding EventKinds}" Width="180" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding EntryTypeFilter}" Width="160" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,12" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource SearchPath}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Event}" Margin="16,0,8,0" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="3" ItemsSource="{Binding EventTypes}" SelectedItem="{Binding SelectedEventFilter}" />
                            <TextBlock Grid.Column="4" Text="{DynamicResource Entry}" Margin="16,0,8,0" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="5" ItemsSource="{Binding EntryTypes}" SelectedItem="{Binding SelectedEntryFilter}" />
                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="ClearFilter_Click" Style="{StaticResource GhostButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconClear}" Style="{StaticResource ToolbarIconStyle}" />
                                        <TextBlock Text="{DynamicResource ClearFilter}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearAllEventsCommand}" Style="{StaticResource DangerButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDelete}" Style="{StaticResource ToolbarIconStyle}" />
                                        <TextBlock Text="{DynamicResource ClearAllEvents}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="EventGrid"
                              Grid.Row="3"
                              ItemsSource="{Binding EventsView}"
                              CanUserSortColumns="False"
                              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="BorderThickness" Value="4,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventType}" Value="{x:Static domain:MonitorEventType.New}"><Setter Property="Background" Value="{DynamicResource NewBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource NewForegroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource NewAccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding EventType}" Value="{x:Static domain:MonitorEventType.Change}"><Setter Property="Background" Value="{DynamicResource ChangeBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource ChangeForegroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ChangeAccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding EventType}" Value="{x:Static domain:MonitorEventType.ModifyProperties}"><Setter Property="Background" Value="{DynamicResource PropertiesBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PropertiesForegroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PropertiesAccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding EventType}" Value="{x:Static domain:MonitorEventType.Delete}"><Setter Property="Background" Value="{DynamicResource DeleteBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource DeleteForegroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DeleteAccentBrush}" /></DataTrigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource CopyRow}" Click="CopySelectedEvent_Click" />
                                <MenuItem Header="{DynamicResource CopyPath}" Click="CopySelectedPath_Click" />
                                <Separator />
                                <MenuItem Header="{DynamicResource ClearAllEvents}" Command="{Binding ClearAllEventsCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Event}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource ChangeAccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EventType}" Value="{x:Static domain:MonitorEventType.New}"><Setter Property="Fill" Value="{DynamicResource NewAccentBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="{x:Static domain:MonitorEventType.ModifyProperties}"><Setter Property="Fill" Value="{DynamicResource PropertiesAccentBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="{x:Static domain:MonitorEventType.Delete}"><Setter Property="Fill" Value="{DynamicResource DeleteAccentBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding EventTypeDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Time}" Binding="{Binding EventTime}" Width="165" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding EntryType}" Width="90" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTemplateColumn Header="{DynamicResource Path}" Width="2.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Hyperlink Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Path}">
                                                <Run Text="{Binding Path, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource OldPath}" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Hyperlink Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding OldPath}">
                                                <Run Text="{Binding OldPath, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Size}" Binding="{Binding FileSize}" Width="90" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Delivery}" Binding="{Binding DeliveryStatus}" Width="110" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource TabOutputs}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDatabase}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource TabOutputs}" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding AddOutputCommand}" Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconAdd}" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{DynamicResource AddOutput}" /></StackPanel>
                            </Button>
                            <Button Command="{Binding EditOutputCommand}" Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconEdit}" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{DynamicResource Edit}" /></StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteOutputCommand}" Style="{StaticResource DangerButtonStyle}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDelete}" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{DynamicResource Delete}" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="OutputGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Destinations}"
                              SelectedItem="{Binding SelectedDestination}"
                              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="OutputGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource Edit}" Command="{Binding EditOutputCommand}" />
                                <MenuItem Header="{DynamicResource Duplicate}" Command="{Binding DuplicateOutputCommand}" />
                                <MenuItem Header="{DynamicResource Delete}" Command="{Binding DeleteOutputCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding Type}" Width="150" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTemplateColumn Header="{DynamicResource Status}" Width="120" CellStyle="{StaticResource CenteredDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="11,4" CornerRadius="12" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource HealthMonitoringBackgroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Delivering"><Setter Property="Background" Value="{DynamicResource HealthDeliveringBackgroundBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Retrying"><Setter Property="Background" Value="{DynamicResource HealthWarningBackgroundBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Background" Value="{DynamicResource HealthDisabledBackgroundBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource HealthMonitoringForegroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Delivering"><Setter Property="Foreground" Value="{DynamicResource HealthDeliveringForegroundBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Retrying"><Setter Property="Foreground" Value="{DynamicResource HealthWarningForegroundBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Foreground" Value="{DynamicResource HealthDisabledForegroundBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Pending}" Binding="{Binding PendingCount}" Width="90" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                            <DataGridTemplateColumn Header="{DynamicResource LastError}" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastError}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LastError}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource LastModified}" Binding="{Binding LastModificationUtc, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="175" ElementStyle="{StaticResource VerticallyCenteredDataGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination.LastError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedDestination.LastError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="105" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource LastErrorDetails}" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CopyLastErrorCommand}" Style="{StaticResource GhostButtonStyle}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCopy}" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{DynamicResource CopyError}" /></StackPanel>
                            </Button>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{DynamicResource OutputRetryExplanation}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10" />
                            <TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SelectedDestination.LastError, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource TabSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Center" Margin="0,0,16,24">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                            <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform" Margin="0,0,9,0" />
                            <TextBlock Text="{DynamicResource AppSettings}" Style="{StaticResource PageTitleStyle}" />
                        </StackPanel>

                        <GroupBox Header="{DynamicResource AppSettings}" HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <CheckBox Content="{DynamicResource StartWithWindows}" IsChecked="{Binding IsStartupEnabled}" Margin="2,4,12,12" />
                                <Grid Grid.Column="1" Margin="12,0,2,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Theme}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedThemeMode}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource ThemeSystem}" Tag="{x:Static domain:AppThemeMode.System}" />
                                        <ComboBoxItem Content="{DynamicResource ThemeLight}" Tag="{x:Static domain:AppThemeMode.Light}" />
                                        <ComboBoxItem Content="{DynamicResource ThemeDark}" Tag="{x:Static domain:AppThemeMode.Dark}" />
                                    </ComboBox>
                                </Grid>
                                <Grid Grid.Row="1" Margin="2,0,12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,2,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource UiBuffer}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding UiBufferLimit, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource RowsRange}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource SQLiteDatabase}" HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="3" Text="{DynamicResource DataLocation}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,2,12" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource DatabasePathLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" MinWidth="450" />
                                <Button Grid.Row="1" Grid.Column="2" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource GhostButtonStyle}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolder}" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{DynamicResource OpenFolder}" /></StackPanel>
                                </Button>
                                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource WarningPanelBrush}" CornerRadius="7" Padding="12" Margin="0,12,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsDatabaseRestartRequired}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DatabaseRestartMessage}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource ImportExport}" HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource ImportExportHelp}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,2,12" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button Command="{Binding ImportDataCommand}" Style="{StaticResource PrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconImport}" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{DynamicResource Import}" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportDataCommand}" Style="{StaticResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconExport}" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{DynamicResource Export}" /></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="2,14,2,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsTransferBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding TransferStatus}" />
                                    <Button Grid.Column="1" Grid.RowSpan="2" Content="{DynamicResource Cancel}" Command="{Binding CancelTransferCommand}" Style="{StaticResource GhostButtonStyle}" />
                                    <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding TransferProgress}" Margin="0,9,12,0" />
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource UpdateSettings}" HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource CurrentVersionLabel}" VerticalAlignment="Center" Margin="2,6" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,6" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource ManifestUrlLabel}" VerticalAlignment="Center" Margin="2,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UpdateManifestUrl, UpdateSourceTrigger=LostFocus}" MinWidth="500" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource UpdateScheduleLabel}" VerticalAlignment="Center" Margin="2,6" />
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding SelectedUpdateSchedule}" SelectedValuePath="Tag" Width="230" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{DynamicResource EveryStartup}" Tag="{x:Static domain:UpdateCheckSchedule.EveryStartup}" />
                                    <ComboBoxItem Content="{DynamicResource Daily}" Tag="{x:Static domain:UpdateCheckSchedule.Daily}" />
                                    <ComboBoxItem Content="{DynamicResource Monthly}" Tag="{x:Static domain:UpdateCheckSchedule.Monthly}" />
                                    <ComboBoxItem Content="{DynamicResource Never}" Tag="{x:Static domain:UpdateCheckSchedule.Never}" />
                                </ComboBox>
                                <TextBlock Grid.Row="3" Text="{DynamicResource LastCheckedLabel}" VerticalAlignment="Center" Margin="2,6" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastUpdateCheck}" VerticalAlignment="Center" Margin="2,6" />
                                <TextBlock Grid.Row="4" Text="{DynamicResource UpdateStatusLabel}" VerticalAlignment="Center" Margin="2,6" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UpdateStatusDisplay}" VerticalAlignment="Center" Margin="2,6" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Text="{DynamicResource SkippedVersionLabel}" VerticalAlignment="Center" Margin="2,6" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SkippedUpdateVersion}" VerticalAlignment="Center" Margin="2,6" />
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="{DynamicResource SaveUpdateSettings}" Command="{Binding SaveUpdateSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="{DynamicResource CheckNow}" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource GhostButtonStyle}" />
                                    <Button Content="{DynamicResource ClearSkippedVersion}" Command="{Binding ClearSkippedUpdateCommand}" Style="{StaticResource GhostButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem Content="{Binding StatusText}" />
            <Separator />
            <StatusBarItem>
                <TextBlock><Run Text="Pending: " /><Run Text="{Binding PendingCount}" FontWeight="SemiBold" /></TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
